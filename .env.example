# Environment Configurations for A-RAG

# FastAPI
PORT=8082
HOST=0.0.0.0
JWT_SECRET=supersecretjwtsecretkeychangeinproduction123!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL
DATABASE_URL=postgresql+psycopg2://admin:Ats%40123*@127.0.0.1:5432/ragstore_prod

# Neo4j
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=Ats@123*

# Qdrant
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333

# Redis (Celery Broker & Result Backend)
REDIS_URL=redis://127.0.0.1:6378/0

# MinIO
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=Ats@123*
MINIO_SECURE=false
MINIO_BUCKET_NAME=arag-knowledge-objects

# OpenAI / vLLM Endpoint
OPENAI_API_BASE=http://127.0.0.1:8000/v1
OPENAI_API_KEY=dummy-key-for-local-vllm
MODEL_NAME=google/gemma-4-31B-it

# NAS Storage Integration
NAS_MOUNT_PATH=/mnt/nas/arag_archive
LOCAL_HOT_PATH=/tmp/arag_hot_cache

# Ingestion Settings
EMBEDDING_DEVICE=cpu # cpu or cuda
GLINER_MODEL=urchade/gliner_medium-v2.1
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
